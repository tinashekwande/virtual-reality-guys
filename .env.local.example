# Copy this file to .env.local and fill in your Supabase values
# Get these from: https://supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public site URL (used for unsubscribe links in marketing emails)
NEXT_PUBLIC_SITE_URL=https://virtualrealityguyz.co.za

# Claude connector (MCP). A long random secret, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then add a custom connector in Claude with URL: https://<your-domain>/api/mcp/<MCP_SECRET_KEY>
MCP_SECRET_KEY=

# Optional: let the portal send marketing emails itself (otherwise Claude sends through Gmail)
# RESEND_API_KEY=
# MARKETING_FROM_EMAIL=Virtual Reality Guys <hello@virtualrealityguyz.co.za>
# or Gmail SMTP with an app password:
# GMAIL_USER=virtualrealityguyz@gmail.com
# GMAIL_APP_PASSWORD=
